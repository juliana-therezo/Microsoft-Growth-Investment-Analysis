      <aliases enabled='yes' />
      <column caption='OI Variance Bn' datatype='real' name='[Calculation_4574307055894554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [line_item] = &apos;Revenue&apos; THEN [variance_bn] ELSE -[variance_bn] END' />
      </column>
      <column caption='Variance vs Budget %' datatype='real' default-format='*+0.0%;-0.0%' name='[Calculation_4574307056762909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([variance_bn]) / SUM([budget_bn])' />
      </column>
      <column caption='Favourability' datatype='real' name='[Calculation_4574307056787486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([line_item]) = &apos;Revenue&apos; THEN [Calculation_4574307056762909] ELSE -[Calculation_4574307056762909] END' />
      </column>
